# Discord bot token (bot application token, NOT a user-account token)
DISCORD_TOKEN=
KOYA_BOT_ID=
KOYA_NAME_PATTERN=^(?i:koya)(?:#|$)

# AI provider
AI_PROVIDER=cloudflare
CLOUDFLARE_AI_URL=https://koya-ai-brain.skynetm4a1.workers.dev
CLOUDFLARE_AI_TOKEN=

# Optional OpenAI fallback (not needed for the free Cloudflare path)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Storage
DB_PATH=koya_ai_player.db

# Agent controls
MIN_CONFIDENCE=0.75
ANALYSIS_COOLDOWN=3.0
MAX_MESSAGES_PER_MINUTE=12
MAX_AI_HISTORY=12
AI_TIMEOUT=30

# Executor: advisory (default) or http (only for an explicitly authorized
# Koya/vendor/local test API that accepts {command,arguments} at POST /actions)
EXECUTOR_MODE=advisory
EXECUTOR_BASE_URL=
EXECUTOR_TOKEN=
EXECUTOR_TIMEOUT=10
